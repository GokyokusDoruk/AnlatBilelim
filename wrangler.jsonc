{
  // Tabu Party: tek bir Cloudflare Worker hem SPA statik dosyalarını sunar
  // hem de /api/* altındaki oda (Durable Object) WebSocket trafiğini yönetir.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tabu-party",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    // /api/* istekleri önce Worker'a gider, geri kalan her şey statik dosyadır.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDurableObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDurableObject"] }],
  "observability": { "enabled": true },
  // dorukplays.com'a bağlamak için (alan adı bu Cloudflare hesabında olmalı) aşağıyı açın:
  // "routes": [{ "pattern": "tabu.dorukplays.com", "custom_domain": true }],
  "workers_dev": true
}
